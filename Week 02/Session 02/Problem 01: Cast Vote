"""
Problem 01: Cast Vote
Write a function cast_vote() that records a vote for a candidate in an election. The function accepts a dictionary votes that maps candidates to their current number of votes and a string candidate that represents the candidate the user would like to vote for. If the candidate doesn't exist, add them to the dictionary. The function should return the updated dictionary.

def cast_vote(votes, candidate):
    pass
Example Usage:

votes = {"Alice": 5, "Bob": 3}
cast_vote(votes, "Alice")
print(votes)
cast_vote(votes, "Gina")
print(votes)
Example Output:

{'Alice': 6, 'Bob': 3}
{'Alice': 6, 'Bob': 3, 'Gina': 1}
"""


def cast_vote(votes, candidate):
    clean_votes = {}
    
    # 1. Clean up and merge all existing keys into lowercase
    for existing_candidate, count in votes.items():
        key = existing_candidate.lower().strip()
        clean_votes[key] = clean_votes.get(key, 0) + count

    # 2. Add the new vote (also in lowercase)
    candidate_lower = candidate.lower()
    clean_votes[candidate_lower] = clean_votes.get(candidate_lower, 0) + 1

    # 3. Update the original dictionary in-place so changes persist
    votes.clear()
    votes.update(clean_votes)

    return votes


votes = {"Alice": 5, "Bob": 3}

cast_vote(votes, "Alice")
print(votes)

cast_vote(votes, "Gina")
print(votes)


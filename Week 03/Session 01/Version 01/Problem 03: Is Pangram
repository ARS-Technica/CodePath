def is_pangram(my_str):
    seen_letters = set()
    
    for char in my_str.lower():
        if char.isalpha():
            seen_letters.add(char)
            # Optimization: stop early once all 26 letters are found
            if len(seen_letters) == 26:
                return True
                
    return len(seen_letters) == 26


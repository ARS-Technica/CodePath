"""
Problem 8: Multiples of Five
Write a function multiples_of_five() that prints out multiples of 5 between 1 and 100 (inclusive).

def multiples_of_five():
    pass
Example Output:

5
10
15
20
25
....
90
95
100
"""

def multiples_of_five():
    # Iterate through a range through 100
    for num in range(1, 101):
        # If multiple of 5
        if num % 5 == 0:
            # Print
            print(num)


multiples_of_five()


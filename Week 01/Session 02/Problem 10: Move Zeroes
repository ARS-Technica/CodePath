def move_zeroes(nums):
    non_zeroes = [x for x in nums if x != 0]
    zero_count = len(nums) - len(non_zeroes)

    return non_zeroes + [0] * zero_count

nums = [1,0,2,3,0,0,4]
new_nums = move_zeroes(nums)
print(new_nums)


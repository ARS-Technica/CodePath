"""
Problem 2: Print Doubled List Items
Write a function doubled() that takes in a list of integers lst as a parameter and prints each item in the list multiplied by two.

def doubled(lst):
    pass
Example Input: lst = [1,2,3]
Example Output:

2
4
6
"""

def doubled(lst):
    if not(lst):
        return []

    # Iterate
    for num in lst:
        # Multiple
        num *= 2
        # Print
        print(num)


# Evaluate
lst = [1,2,3]

doubled(lst)


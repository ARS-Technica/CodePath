"""
Problem 6: Reverse List
Write a function reverse_list() that takes in a list lst as a parameter and returns a new list containing the elements of lst in reverse order.

def reverse_list(lst):
    pass
    
Example Usage:

lst = [1,2,3,4,5]
rev_lst = reverse_list(lst)
print(rev_lst)
Example Output:

[5,4,3,2,1]
"""


def reverse_list(lst):
    res = []
    length = len(lst) - 1

    """
    for num in lst:
        res.insert(0, num)
    """

    """
    for num in range(length, -1, -1):
        print(num)
        res.append(lst[num])
    """

    for num in lst[::-1]:
        res.append(num)

    return res
    

lst = [1,2,3,4,5]
rev_lst = reverse_list(lst)
print(rev_lst)


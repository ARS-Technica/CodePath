"""
Write a function get_last() that takes in a list as a parameter and returns the last item in the list. Return None if the list is empty.

def get_last(lst):
    pass
Example Input: [3,1,6,7,5]
Example Output: 5
"""

def get_last(lst):
    if not lst:
        return None
    else:
        return lst[-1]

print(get_last([1, 2, 3]))
print(get_last([]))


